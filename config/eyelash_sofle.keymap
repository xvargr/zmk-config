#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <800>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    media_encoder: media_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_NEXT>, <&kp C_PREV>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    behaviors {
        sk_kp: sticky_keypress {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <4000>;
            quick-release;
            bindings = <&kp>;
        };
        sk_mod: sticky_layer_mod {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <4000>;
            quick-release;
            bindings = <&mo>;
        };
        lt_sticky: layer_tap_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&sk_mod>;
        };
        td_l_brkt: tap_dance_left_brackets {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBRC>, <&kp LBKT>;
        };
        td_r_brkt: tap_dance_right_brackets {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings =  <&kp RBRC>, <&kp RBKT>;
        };
        td_mindash: tap_dance_minus_dash {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };
        td_pluseq: tap_dance_plus_equals {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp EQUAL>, <&kp PLUS>;
        };
        td_quot: tap_dance_quotes {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SQT>, <&kp DQT>;
        };
        td_bt_sel: tap_dance_bluetooth_select {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 1>, <&bt BT_SEL 2>, <&bt BT_SEL 3>, <&bt BT_SEL 4>;
        };
        ht_shift: hold_tap_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk_kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC                &kp N1        &kp N2                 &kp N3        &kp N4          &kp N5     &kp UP_ARROW     &kp N6     &kp N7     &kp N8          &kp N9         &kp N0      &kp BACKSPACE
&kp TAB                &kp Q         &kp W                  &kp E         &kp R           &kp T      &kp DOWN_ARROW   &kp Y      &kp U      &kp I           &kp O          &kp P       &kp BSLH
&ht_shift LSHFT LSHFT  &kp A         &kp S                  &kp D         &kp F           &kp G      &kp LEFT_ARROW   &kp H      &kp J      &kp K           &kp L          &kp SEMI    &kp SQT
&kp LCTRL              &kp Z         &kp X                  &kp C         &kp V           &kp B      &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA       &kp DOT        &kp FSLH    &ht_shift RSHFT RSHFT
&kp C_MUTE             &kp LEFT_ALT  &ht_shift LSHFT LSHFT  &kp LEFT_GUI  &lt_sticky 2 2  &kp SPACE  &kp ENTER        &kp SPACE  &kp ENTER  &lt_sticky 1 1  &kp BACKSPACE  &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&kp TILDE         &kp EXCL     &kp AT       &kp HASH     &kp DOLLAR    &kp PERCENT   &mmv MOVE_UP     &kp CARET   &kp AMPS    &kp STAR   &td_l_brkt   &td_r_brkt  &kp DELETE
&kp GRAVE         &trans       &trans       &trans       &trans        &trans        &mmv MOVE_DOWN   &trans      &trans      &trans     &td_mindash  &td_pluseq  &kp PIPE
&trans            &trans       &trans       &trans       &trans        &trans        &mmv MOVE_LEFT   &kp LEFT    &kp DOWN    &kp UP     &kp RIGHT    &kp COLON   &kp DQT
&trans            &trans       &trans       &trans       &trans        &trans        &mmv MOVE_RIGHT  &trans      &trans      &kp LT     &kp GT       &kp QMARK   &trans
&kp C_PLAY_PAUSE  &trans       &trans       &trans       &trans        &trans        &mkp LCLK        &trans      &trans      &trans     &trans       &trans
            >;

            sensor-bindings = <&media_encoder>;
            display-name = "RMOD";
        };

        layer_2 {
            bindings = <
&trans           &kp F1           &kp F2           &kp F3           &kp F4      &kp F5     &mmv MOVE_UP     &kp F6          &kp F7          &kp F8            &kp F9             &kp F10           &kp F11
&trans           &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &trans      &trans     &mmv MOVE_DOWN   &trans          &mkp LCLK       &mkp RCLK         &trans             &trans            &kp F12
&kp CAPS         &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &trans      &trans     &mmv MOVE_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP      &mmv MOVE_RIGHT    &trans            &trans
&rgb_ug RGB_TOG  &out OUT_USB     &out OUT_BLE     &soft_off        &bootloader &sys_reset &mmv MOVE_RIGHT  &sys_reset      &bootloader     &soft_off         &trans             &kp BSLH          &trans
&trans           &td_bt_sel       &trans           &trans           &trans      &trans     &mkp LCLK        &trans          &trans          &trans            &trans             &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            display-name = "LMOD";
        };

/*         layer_3 { */
/*             bindings = < */
/* &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans */
/* &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans */
/* &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans */
/* &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans */
/* &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans */
/*             >; */
/*         }; */
    };
};
